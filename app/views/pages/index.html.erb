<% content_for :title, @nav.dig("meta", "title").presence || "服務與 API 導覽" %>

<style>
  .service-nav-page { max-width: 42rem; margin: 0 auto; padding: 2rem 1rem; font-family: "Microsoft JhengHei", "PingFang TC", "Noto Sans TC", sans-serif; }
  .service-nav-page h1 { font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.25rem; }
  .service-nav-page .subtitle { font-size: 0.9375rem; color: #475569; margin-bottom: 2rem; }
  .service-nav-page section { margin-bottom: 2rem; }
  .service-nav-page section h2 { font-size: 1.125rem; font-weight: 600; color: #334155; margin-bottom: 0.75rem; padding-bottom: 0.375rem; border-bottom: 2px solid #e2e8f0; }
  .service-nav-page .card { display: block; padding: 1rem 1.25rem; margin-bottom: 0.75rem; border-radius: 0.5rem; border: 1px solid #e2e8f0; background: #fff; text-decoration: none; color: inherit; transition: border-color 0.15s, box-shadow 0.15s; }
  .service-nav-page .card:hover { border-color: #0ea5e9; box-shadow: 0 2px 8px rgba(14, 165, 233, 0.15); }
  .service-nav-page .card .name { font-weight: 600; color: #0f172a; margin-bottom: 0.25rem; }
  .service-nav-page .card .path { font-size: 0.8125rem; font-family: ui-monospace, monospace; color: #64748b; margin-bottom: 0.375rem; }
  .service-nav-page .card .desc { font-size: 0.875rem; color: #475569; line-height: 1.5; }
  .service-nav-page .card.api .path { color: #0369a1; }
  .service-nav-page .card .method { display: inline-block; font-size: 0.75rem; font-weight: 600; padding: 0.125rem 0.5rem; border-radius: 0.25rem; background: #e0f2fe; color: #0369a1; margin-right: 0.5rem; }
  .service-nav-page .page-footer { margin-top: 2rem; padding-top: 1rem; text-align: center; font-size: 0.8125rem; color: #64748b; }
  .service-nav-page .page-footer a { color: #0ea5e9; text-decoration: none; }
  .service-nav-page .page-footer a:hover { text-decoration: underline; }
</style>

<div class="service-nav-page">
  <h1><%= @nav.dig("meta", "title").presence || "服務與 API 導覽" %></h1>
  <p class="subtitle"><%= @nav.dig("meta", "description").presence || "本機／同一伺服器上已發布的網頁服務與 API，供測試與說明。" %></p>

  <section>
    <h2>網頁服務</h2>
    <% (@nav["pages"] || []).each do |item| %>
      <% item = item.is_a?(Hash) ? item : {} %>
      <a href="<%= item["path"].to_s %>" class="card">
        <div class="name"><%= item["name"].presence || item["path"] %></div>
        <div class="path"><%= item["path"].to_s %></div>
        <div class="desc"><%= item["description"].to_s %></div>
      </a>
    <% end %>
    <% if (@nav["pages"] || []).empty? %>
      <p style="font-size: 0.875rem; color: #64748b;">尚無網頁服務。請依 docs/21 在 config/service_nav.yml 新增。</p>
    <% end %>
  </section>

  <section>
    <h2>API</h2>
    <% (@nav["apis"] || []).each do |item| %>
      <% item = item.is_a?(Hash) ? item : {} %>
      <div class="card api">
        <div class="name">
          <% if item["method"].present? %><span class="method"><%= item["method"] %></span><% end %>
          <%= item["name"].presence || item["path"] %>
        </div>
        <div class="path"><%= item["path"].to_s %></div>
        <div class="desc"><%= item["description"].to_s %></div>
      </div>
    <% end %>
    <% if (@nav["apis"] || []).empty? %>
      <p style="font-size: 0.875rem; color: #64748b;">尚無 API 項目。請依 docs/21 在 config/service_nav.yml 新增。</p>
    <% end %>
  </section>

  <p class="page-footer">
    發布新服務時請依專案 <strong>docs/21-服務導覽與發布治理.md</strong> 編輯 config/service_nav.yml 並部署。
  </p>
</div>
